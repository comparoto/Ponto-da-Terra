{
  "name": "ponto-da-terra-api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST do Origem: Ponto da Terra",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "vercel-build": "prisma generate && prisma migrate deploy",
    "worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "jest --runInBand",
    "test:cobertura": "jest --runInBand --coverage",
    "test:carga": "k6 run tests/carga/checkout-concorrente.k6.js",
    "test:carga:vitrine": "k6 run tests/carga/vitrine-cache.k6.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@prisma/client": "6.19.3",
    "@upstash/qstash": "2.12.1",
    "@vercel/blob": "2.9.0",
    "@vercel/functions": "3.11.1",
    "bcryptjs": "3.0.3",
    "bullmq": "6.7.4",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.12.1",
    "multer": "2.5.0",
    "qrcode": "1.5.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "dotenv-cli": "11.1.0",
    "jest": "30.5.2",
    "prisma": "6.19.3",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "@scarf/scarf": false,
    "@parcel/watcher": false,
    "msgpackr-extract": false
  },
  "engines": {
    "node": "22.x"
  }
}
