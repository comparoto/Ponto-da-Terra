NODE_ENV=development
PORT=3333

# PostgreSQL (docker compose -> porta 5434)
DATABASE_URL="postgresql://pdt:pdt@localhost:5434/pontodaterra?schema=public"

# Redis (cache do catálogo e, na fase 2, filas BullMQ)
REDIS_URL="redis://localhost:6380/0"
CACHE_TTL_SECONDS=60

# Autenticação
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="2h"

# Origem do frontend Next.js
CORS_ORIGIN="http://localhost:3000,http://localhost:3002"
UPLOAD_DIR=uploads

# URL pública da API (usada para montar a URL absoluta das imagens enviadas)
PUBLIC_URL="http://localhost:3333"

# Segredo do webhook do gateway de pagamento (simulado)
WEBHOOK_SECRET="dev-webhook-secret"

# Conexão direta usada pelas migrations (no Neon/Vercel: a URL sem pooler). Localmente, a mesma do DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://pdt:pdt@localhost:5434/pontodaterra?schema=public"

# ───── E-mail (opcional) ─────
# SMTP do provedor. Exemplos:
#   Mailtrap (caixa de testes): smtp://USUARIO:SENHA@sandbox.smtp.mailtrap.io:2525
#   Resend:                     smtps://resend:re_SUA_CHAVE@smtp.resend.com:465
#   Brevo:                      smtp://LOGIN:CHAVE_SMTP@smtp-relay.brevo.com:587
# Vazio: os e-mails só aparecem no log do worker/API.
SMTP_URL=
EMAIL_REMETENTE="Ponto da Terra <nao-responda@pontodaterra.com.br>"
# Endereço do site, usado nos links dos e-mails (redefinir senha, acompanhar pedido...)
SITE_URL="http://localhost:3000"

# ───── Implantação na Vercel (deixe vazio para rodar localmente com BullMQ + disco) ─────
# Preenchidas automaticamente pelas integrações do Marketplace da Vercel:
#   Neon ............ DATABASE_URL (com pooler) e DATABASE_URL_UNPOOLED (direta)
#   Upstash Redis ... REDIS_URL ou KV_URL
#   Upstash QStash .. QSTASH_TOKEN, QSTASH_URL, QSTASH_CURRENT_SIGNING_KEY, QSTASH_NEXT_SIGNING_KEY
#   Vercel Blob ..... BLOB_READ_WRITE_TOKEN
QSTASH_TOKEN=
QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
BLOB_READ_WRITE_TOKEN=
# Segredo que o Vercel Cron envia em "Authorization: Bearer ..." para as rotas /api/jobs/*
CRON_SECRET=
