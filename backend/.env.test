NODE_ENV=test
PORT=3333

# PostgreSQL (docker compose -> porta 5434)
DATABASE_URL="postgresql://pdt:pdt@localhost:5434/pontodaterra_test?schema=public"

# Redis (cache do catálogo e, na fase 2, filas BullMQ)
REDIS_URL="redis://localhost:6380/1"
CACHE_TTL_SECONDS=60

# Autenticação
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="2h"

# Origem do frontend Next.js
CORS_ORIGIN="http://localhost:3000"
UPLOAD_DIR=uploads-test

# Segredo do webhook do gateway de pagamento (simulado)
WEBHOOK_SECRET="dev-webhook-secret"

# Conexão direta usada pelas migrations (no Neon/Vercel: a URL sem pooler). Localmente, a mesma do DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://pdt:pdt@localhost:5434/pontodaterra_test?schema=public"

# Segredo das tarefas agendadas (Vercel Cron) — usado nos testes das rotas /api/jobs
CRON_SECRET="segredo-cron-de-teste"
